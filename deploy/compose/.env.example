# Loom compose environment. Copy to `.env` (same directory as
# docker-compose.yaml) and edit before `docker compose up`.

# --- Engine (internal/config) ---

# CE_HTTP_ADDR: address the Engine's HTTP server listens on inside the
# container. Leave as :8080 unless you also change the Dockerfile EXPOSE and
# the compose port mapping.
CE_HTTP_ADDR=:8080

# CE_ENV: deployment environment label, informational only.
CE_ENV=development

# CE_DATABASE_URL: Postgres DSN (ADR-0007). The default below points at the
# bundled `postgres` service; only override this if you're running Postgres
# elsewhere.
CE_DATABASE_URL=postgres://loom:loom@postgres:5432/loom?sslmode=disable

# --- Embedder (internal/embed) ---

# CE_EMBEDDER_BASE_URL: OpenAI-compatible embeddings endpoint. Defaults to
# OpenAI itself. To use the bundled local Embedder instead (see the `tei`
# service, `--profile local-embedder`), set:
#   CE_EMBEDDER_BASE_URL=http://tei:80/v1
CE_EMBEDDER_BASE_URL=https://api.openai.com/v1

# CE_EMBEDDER_API_KEY: bearer token sent to CE_EMBEDDER_BASE_URL. Leave empty
# for endpoints that don't require auth (e.g. the local `tei` service) — the
# header is omitted entirely rather than sent blank.
CE_EMBEDDER_API_KEY=

# CE_EMBEDDER_MODEL: embedding model name sent to CE_EMBEDDER_BASE_URL.
# Required — the Engine refuses to start without it.
CE_EMBEDDER_MODEL=text-embedding-3-small

# CE_EMBEDDER_DIMENSIONS: vector width produced by CE_EMBEDDER_MODEL.
# Required. Changing this on a deployment with existing Passages requires a
# Reindex.
CE_EMBEDDER_DIMENSIONS=1536

# --- Postgres (bundled `postgres` service) ---
# Must stay in sync with the credentials embedded in CE_DATABASE_URL above.
POSTGRES_USER=loom
POSTGRES_PASSWORD=loom
POSTGRES_DB=loom

# --- Neo4j (bundled `neo4j` service, ADR-0009: present, not queried by v0) ---
# Optional: behind the `graph` compose profile (story 12 — only Postgres
# is required for baseline retrieval). Enable with
# `docker compose ... --profile graph up`. neo4j's own "user/password"
# auth string:
NEO4J_AUTH=neo4j/changeme

# --- Local Embedder (optional `tei` service, `--profile local-embedder`) ---
# TEI_MODEL: HuggingFace model id served by text-embeddings-inference. Its
# output width must match CE_EMBEDDER_DIMENSIONS above.
TEI_MODEL=BAAI/bge-small-en-v1.5
